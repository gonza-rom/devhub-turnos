generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── COPIADO DEL POS ──────────────────────────────────

model Tenant {
  id           String    @id @default(cuid())
  nombre       String
  email        String    @unique
  slug         String    @unique
  logoUrl      String?
  telefono     String?
  direccion    String?
  ciudad       String?
  provincia    String?
  descripcion  String?
  instagram    String?
  facebook     String?
  sitioWeb     String?
  plan         PlanTipo  @default(FREE)
  activo       Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // ── NUEVO ──
  rubro          RubroTipo?
  customDomain   String?   @unique
  domainVerified Boolean   @default(false)

  usuarios   UsuarioTenant[]
  suscripcion Suscripcion?

  // ── NUEVO ──
  servicios  ServicioTurno[]
  horarios   HorarioDisponible[]
  turnos     Turno[]
  bloqueos   BloqueoHorario[]
}

model UsuarioTenant {
  id         String    @id @default(cuid())
  tenantId   String
  supabaseId String    @unique
  nombre     String
  email      String
  rol        RolTenant @default(EMPLEADO)
  activo     Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([supabaseId])
}

model Suscripcion {
  id                 String    @id @default(cuid())
  tenantId           String    @unique
  plan               PlanTipo
  estado             String    @default("pending")
  mpPreapprovalId    String?
  mpSubscriptionId   String?
  proximoVencimiento DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  tenant             Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
}

// ── NUEVO — TABLAS DE TURNOS ─────────────────────────

model ServicioTurno {
  id          String   @id @default(cuid())
  tenantId    String
  nombre      String
  descripcion String?
  precio      Float?
  duracionMin Int
  activo      Boolean  @default(true)
  orden       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  turnos Turno[]

  @@index([tenantId, activo])
}

model HorarioDisponible {
  id         String  @id @default(cuid())
  tenantId   String
  diaSemana  Int     // 0=Dom 1=Lun ... 6=Sab
  horaInicio String  // "09:00"
  horaFin    String  // "20:00"
  activo     Boolean @default(true)

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, diaSemana])
  @@index([tenantId])
}

model Turno {
  id                String      @id @default(cuid())
  tenantId          String
  servicioId        String
  clienteNombre     String
  clienteTelefono   String
  clienteEmail      String?
  fechaHora         DateTime
  duracionMin       Int
  estado            EstadoTurno @default(PENDIENTE)
  notasCliente      String?
  notasAdmin        String?
  canceladoAt       DateTime?
  motivoCancelacion String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  tenant   Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  servicio ServicioTurno @relation(fields: [servicioId], references: [id])

  @@index([tenantId, fechaHora])
  @@index([tenantId, estado])
  @@index([clienteTelefono])
}

model BloqueoHorario {
  id         String   @id @default(cuid())
  tenantId   String
  fechaDesde DateTime
  fechaHasta DateTime
  motivo     String?
  createdAt  DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, fechaDesde])
}

// ── ENUMS ────────────────────────────────────────────

enum PlanTipo {
  FREE
  PRO
  ENTERPRISE
}

enum RolTenant {
  PROPIETARIO
  ADMINISTRADOR
  EMPLEADO
}

enum RubroTipo {
  BARBERIA
  DETAILING
  ESTETICA
  MEDICO
  OTRO
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  CANCELADO
  COMPLETADO
  AUSENTE
}